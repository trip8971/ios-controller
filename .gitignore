# Swift Package Manager
.swiftpm/
Package.resolved.user
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# Xcode test results / archives
*.xcresult/
*.xcarchive/

# CocoaPods (if ever added)
Pods/

# Carthage (if ever added)
Carthage/Build/

# fastlane (if ever added)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

