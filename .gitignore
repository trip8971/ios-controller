.AppleDouble
.LSOverride
Icon?
._*

# ──────────────────────── Xcode / Swift / SPM ────────────────────
# Build output
.build/
**/.build/
.derived-data/
DerivedData/
build/
*.xcodeproj/build/

# User-specific Xcode files
xcuserdata/
**/xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Workspace user state (keep shared schemes via xcshareddata)
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
